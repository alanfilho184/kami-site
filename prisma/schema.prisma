// Fonte de verdade do schema do Kami a partir da D2.
// O runtime do site usa pg + sql-template-strings; este schema serve às migrations.
// O Prisma Client não é gerado neste repositório. O bot mantém um espelho próprio
// até ser atualizado para consumir este schema.

datasource db {
  provider = "postgresql"
}

enum Ban_Type {
  TEMPORARY
  PERMANENT
  UNBANNED
}

enum Available_Languages {
  PT_BR @map("pt-br")
  EN_US @map("en-us")
}

enum ActivityStatus {
  SUCCESS
  FAILED
}

enum AnnouncementMode {
  ALWAYS
  ONCE
  INTERVAL
}

model users {
  id                Int       @id @default(autoincrement())
  discord_id        String?   @unique
  username          String?   @unique
  avatar            String?
  email             String?   @unique
  password          String?
  is_beta           Boolean   @default(false)
  is_premium        Boolean   @default(false)
  last_use          DateTime  @default(now()) @updatedAt @db.Timestamptz
  created_at        DateTime  @default(now())
  terms_accepted_at DateTime? @db.Timestamptz
  email_verified_at DateTime? @db.Timestamptz

  blocked_users      blocked_users[]
  irt_sheets         irt_sheets[]
  sheets             sheets[]
  user_config        users_config[]
  macros             macros[]
  announcementsSeens announcements_seen[]
  site_sessions      site_sessions[]
  site_sync_codes    site_sync_codes[]

  @@index([last_use])
}

model site_sessions {
  id           Int      @id @default(autoincrement())
  user_id      Int
  token_hash   String   @unique @db.Char(64)
  created_at   DateTime @default(now()) @db.Timestamptz
  last_seen_at DateTime @default(now()) @db.Timestamptz
  expires_at   DateTime @db.Timestamptz
  ip           String?  @db.Inet
  user_agent   String?
  user         users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
}

model socket_io_attachments {
  id         BigInt   @id @default(autoincrement())
  created_at DateTime @default(now()) @db.Timestamptz
  payload    Bytes

  @@index([created_at])
}

model site_sync_codes {
  id                       Int       @id @default(autoincrement())
  user_id                  Int
  code_hash                String    @unique @db.Char(64)
  status                   String    @default("pending") @db.VarChar(16)
  claimed_discord_id       String?
  claimed_discord_username String?
  claimed_at               DateTime? @db.Timestamptz
  confirmed_at             DateTime? @db.Timestamptz
  expires_at               DateTime  @db.Timestamptz
  created_at               DateTime  @default(now()) @db.Timestamptz
  user                     users     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, status])
  @@index([expires_at])
  @@index([claimed_discord_id])
}

model site_account_merges {
  id           Int      @id @default(autoincrement())
  from_user_id Int
  to_user_id   Int
  discord_id   String
  snapshot     Json
  created_at   DateTime @default(now()) @db.Timestamptz

  @@index([to_user_id])
  @@index([created_at])
}

model blocked_users {
  id           Int      @id @default(autoincrement())
  User         users    @relation(fields: [user_id], references: [id])
  user_id      Int
  ban_count    Int
  current_ban  Ban_Type
  ban_duration DateTime @db.Timestamptz
  last_use     DateTime @default(now()) @updatedAt @db.Timestamptz
  created_at   DateTime @default(now())
}

model irt_sheets {
  id             Int       @id @default(autoincrement())
  User           users     @relation(fields: [user_id], references: [id])
  user_id        Int
  Sheet_Id       sheets    @relation(fields: [sheet_id], references: [id])
  sheet_id       Int
  msg_id         String
  channel_id     String
  last_synced_at DateTime? @db.Timestamptz
  sync_failures  Int       @default(0)
  last_use       DateTime  @default(now()) @updatedAt @db.Timestamptz
  created_at     DateTime  @default(now())

  @@index([sheet_id])
  @@index([msg_id])
  @@index([user_id])
}

model servers_config {
  id             Int                 @id @default(autoincrement())
  server_id      String
  language       Available_Languages
  force_language Boolean             @default(false)
  last_use       DateTime            @default(now()) @updatedAt @db.Timestamptz
  created_at     DateTime            @default(now())
}

model sheets {
  id             Int          @id @default(autoincrement())
  User           users        @relation(fields: [user_id], references: [id])
  user_id        Int
  sheet_name     String
  sheet_password String?
  last_use       DateTime     @default(now()) @updatedAt @db.Timestamptz
  attributes     Json
  sheet_layout   Json?
  legacy         Boolean      @default(false)
  is_public      Boolean      @default(false)
  created_at     DateTime     @default(now())
  irt_sheets     irt_sheets[]

  @@index([user_id])
  @@index([user_id, sheet_name], name: "idx_sheets_user_sheet_name")
}

model macros {
  id         Int      @id @default(autoincrement())
  User       users    @relation(fields: [user_id], references: [id])
  user_id    Int
  macro_name String
  macros     Json
  last_use   DateTime @default(now()) @updatedAt @db.Timestamptz
  is_public  Boolean  @default(false)
  created_at DateTime @default(now())
}

