{
    "name": "kami-site",
    "version": "6.2.1",
    "private": true,
    "type": "module",
    "description": "Site e plataforma web do Kami.",
    "license": "CC BY-NC-ND 4.0",
    "engines": {
        "node": ">=24.12.0"
    },
    "scripts": {
        "dev": "nuxt dev --host 0.0.0.0 --port 3001 --public",
        "build": "nuxt build",
        "preview": "nuxt preview",
        "start": "node --env-file-if-exists=.env .output/server/index.mjs",
        "postinstall": "nuxt prepare",
        "typecheck": "nuxt typecheck",
        "typecheck:fast": "tsgo --noEmit --project tsconfig.json",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "playwright test",
        "db:validate": "prisma validate",
        "db:format": "prisma format",
        "db:status": "prisma migrate status",
        "db:diff": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --script",
        "db:migrate": "prisma migrate deploy",
        "db:migrate:create": "prisma migrate dev --create-only",
        "check": "npm run format:check && npm run db:validate && npm run typecheck && npm run test && npm run build"
    },
    "dependencies": {
        "@socket.io/postgres-adapter": "^0.5.0",
        "bcryptjs": "^3.0.3",
        "engine.io": "^6.6.11",
        "nuxt": "^4.6.4",
        "pg": "^8.23.1",
        "socket.io": "^4.8.4",
        "socket.io-client": "^4.8.4",
        "sql-template-strings": "^2.2.2",
        "vue": "^3.5.45",
        "vue-router": "^5.4.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@playwright/test": "^1.65.0",
        "@types/node": "^24.19.2",
        "@types/pg": "^8.23.1",
        "@typescript/native-preview": "^7.0.0-dev.20260707.2",
        "prettier": "^3.9.10",
        "prisma": "^7.10.1",
        "typescript": "^6.0.3",
        "vitest": "^5.1.0",
        "vue-tsc": "^3.3.14"
    }
}
