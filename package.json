{
    "name": "kami-site",
    "version": "6.0.0",
    "private": true,
    "type": "module",
    "description": "Site e plataforma web do Kami.",
    "license": "CC BY-NC-ND 4.0",
    "engines": {
        "node": ">=24.12.0"
    },
    "scripts": {
        "dev": "nuxt dev --host 0.0.0.0",
        "build": "nuxt build",
        "preview": "nuxt preview",
        "start": "node --env-file-if-exists=.env .output/server/index.mjs",
        "postinstall": "nuxt prepare",
        "typecheck": "nuxt typecheck",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "playwright test",
        "check": "npm run format:check && npm run typecheck && npm run test && npm run build"
    },
    "dependencies": {
        "nuxt": "^4.6.3",
        "pg": "^8.23.1",
        "sql-template-strings": "^2.2.2",
        "vue": "^3.5.44",
        "vue-router": "^5.4.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@playwright/test": "^1.64.1",
        "@types/node": "^24.19.2",
        "@types/pg": "^8.23.1",
        "prettier": "^3.9.10",
        "typescript": "^5.9.3",
        "vitest": "^5.0.5",
        "vue-tsc": "^3.3.13"
    }
}
