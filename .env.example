# Público - pode ir para o cliente.
NUXT_PUBLIC_SITE_URL=http://localhost:3000
NUXT_PUBLIC_ENVIRONMENT=development
NUXT_PUBLIC_DISCORD_INVITE=https://discord.gg/9rqCkFB
NUXT_PUBLIC_BOT_INVITE=https://discord.com/oauth2/authorize?client_id=716053210179043409

# Servidor - nunca expor no cliente.
DATABASE_URL=postgresql://kami_app:senha@127.0.0.1:5432/kami_prod
SESSION_SECRET=troque-por-32-bytes-aleatorios-0000000000000000
SYNC_CODE_SECRET=troque-por-32-bytes-aleatorios-2222222222222222
BOT_SYNC_TOKEN=troque-por-32-bytes-aleatorios-1111111111111111
DISCORD_LOG_WEBHOOK_URL=https://discord.com/api/webhooks/000000000000000000/troque-este-token
OWNER_DISCORD_ID=000000000000000000
LOG_LEVEL=info
INSTANCE_NAME=kami-site-dev
# Logger remoto opcional: sem URL/token, o site grava apenas no stdout.
# LOGGER_URL=http://127.0.0.1:3002
# LOGGER_TOKEN=klp_troque-pelo-token-de-ingestao
LOG_HTTP_PAYLOADS=true
LOG_WS_PAYLOADS=true
LOG_PAYLOAD_MAX_BYTES=16384
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=5000

# Migrations - role com DDL, usada apenas pela CLI do Prisma.
MIGRATION_DATABASE_URL=postgresql://kami_migrator:senha@127.0.0.1:5432/kami_prod
PRISMA_SHADOW_DATABASE_URL=postgresql://kami_migrator:senha@127.0.0.1:5432/kami_shadow
